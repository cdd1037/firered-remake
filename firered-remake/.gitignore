# Bounded temporary test hosts and NuGet scratch, never source.
/.runtime-tmp/

# Reconstructed font link and Godot import metadata for the doubles test host.
/tests/CampaignDoubleHost/Assets/

# Derived Godot import sidecars beside immutable test screenshot evidence.
/tests/**/evidence/**/*.png.import

# Regenerated original C command body, not an authored oracle adapter.
/tests/Game.SharedFieldRecipes.Tests/source-commands.h

# Rebuilt original C oracle, not authored source.
/tests/Game.SourceCaptureBalls.Tests/evidence/source-c-final/oracle.c

# Frozen Ruby validation binaries are rebuildable; retain only their hashes and source manifests.
/evidence/sevii-ruby-combination-20261013/product*/*.dll

# Six Island fixed-cohort binaries and linked headless resources are regenerated.
/evidence/six-island-combination-20261013/**/*.dll
