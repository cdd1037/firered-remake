#!/usr/bin/env python3
"""One reproducible entry point. Never install, relax a gate, or rewrite golden results implicitly."""
import sys, os, json, subprocess, pathlib, hashlib, re, shutil, tarfile, zipfile
ROOT=pathlib.Path(__file__).resolve().parent
LOCK=json.loads((ROOT/'toolchain.lock.json').read_text(encoding='utf-8'))
for variable,filename in [('FIRERED_TOOLCHAIN_ROOT','toolchain-root'),('FIRERED_ORIGINAL_REFERENCE','reference-root')]:
 local=ROOT/'.tools'/filename
 if variable not in os.environ and local.is_file():os.environ[variable]=local.read_text(encoding='utf-8').strip()
TOOLS=pathlib.Path(os.environ.get('FIRERED_TOOLCHAIN_ROOT','/workspace/shared/firered-toolchains'))
DOTNET=TOOLS/'dotnet/dotnet'
GODOT=TOOLS/'godot/Godot_v4.7.2-stable_mono_linux_x86_64/Godot_v4.7.2-stable_mono_linux.x86_64'
ENV=os.environ.copy()
ENV['FIRERED_TOOLCHAIN_ROOT']=str(TOOLS)
ENV.update(DOTNET_ROOT=str(DOTNET.parent),DOTNET_CLI_HOME=str(ROOT/'.toolhome'),NUGET_PACKAGES=str(ROOT/'.toolhome/nuget'),XDG_DATA_HOME=str(ROOT/'.toolhome/share'),XDG_CONFIG_HOME=str(ROOT/'.toolhome/config'),XDG_CACHE_HOME=str(ROOT/'.toolhome/cache'),DOTNET_NOLOGO='1',DOTNET_CLI_TELEMETRY_OPTOUT='1',DOTNET_MULTILEVEL_LOOKUP='0')
ENV['GODOT']=str(GODOT)
ENV['PATH']=str(DOTNET.parent)+os.pathsep+ENV.get('PATH','')
for key in ('DOTNET_CLI_HOME','NUGET_PACKAGES','XDG_DATA_HOME','XDG_CONFIG_HOME','XDG_CACHE_HOME'): pathlib.Path(ENV[key]).mkdir(parents=True,exist_ok=True)
(ROOT/'evidence').mkdir(exist_ok=True)
def output(value, code=0):
 print(json.dumps(value,ensure_ascii=False,indent=2)); return code


def run(args,log=None,extra=None,cwd=ROOT):
 env=ENV| (extra or {})
 p=subprocess.run([str(a) for a in args],cwd=cwd,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
 if log:(ROOT/'evidence'/log).write_text(p.stdout, encoding='utf-8', newline='\n')
 print(p.stdout,end='')
 if p.returncode or re.search(r'^ERROR:',p.stdout,re.M): raise RuntimeError(f'command failed ({p.returncode}): {args}')
 return p.stdout


def doctor():
 checks=[]
 for label,path,args,expected in [('dotnetSdk',DOTNET,['--version'],LOCK['dotnetSdk']),('godot',GODOT,['--version'],'4.7.2.stable.mono')]:
  if not path.exists():checks.append({'id':label,'passed':False,'error':'missing_tool','path':str(path)});continue
  result=subprocess.run([str(path),*args],cwd=ROOT,env=ENV,capture_output=True,text=True)
  actual=result.stdout.strip();checks.append({'id':label,'passed':result.returncode==0 and actual.startswith(expected),'actual':actual,'expected':expected})
 result={'stage':'doctor','passed':all(c['passed'] for c in checks),'checks':checks,'note':'Tool availability is not P0 compatibility or audio acceptance.'}
 (ROOT/'evidence/doctor.json').write_text(json.dumps(result,indent=2)+'\n', encoding='utf-8', newline='\n');return output(result,0 if result['passed'] else 1)


def setup():
 # Explicit only. Official archives and hash values are fixed in the reviewed lock file.
 import urllib.request
 target=TOOLS/'downloads';target.mkdir(parents=True,exist_ok=True)
 for a in LOCK['assets']:
  p=target/a['name'];alg='sha512' if 'sha512'in a else 'sha256'
  if not p.exists():urllib.request.urlretrieve(a['url'],p)
  with p.open('rb') as f:actual=hashlib.file_digest(f,alg).hexdigest()
  if actual!=a[alg]:raise RuntimeError('toolchain_hash_mismatch: '+a['name'])
 if not DOTNET.exists():
  DOTNET.parent.mkdir(parents=True,exist_ok=True)
  with tarfile.open(target/'dotnet-sdk-10.0.401-linux-x64.tar.gz') as t:t.extractall(DOTNET.parent,filter='data')
 if not GODOT.exists():
  with zipfile.ZipFile(target/'Godot_v4.7.2-stable_mono_linux_x86_64.zip') as z:z.extractall(TOOLS/'godot')
 GODOT.chmod(0o755)
 dest=pathlib.Path(ENV['XDG_DATA_HOME'])/'godot/export_templates/4.7.2.stable.mono';dest.mkdir(parents=True,exist_ok=True)
 with zipfile.ZipFile(target/'Godot_v4.7.2-stable_mono_export_templates.tpz') as z:
  for name in ['linux_debug.x86_64','linux_release.x86_64','version.txt']:(dest/name).write_bytes(z.read('templates/'+name))
 local=GODOT.parent/'GodotSharp/Tools/nupkgs'
 (ROOT/'NuGet.Config').write_text(f'<?xml version="1.0" encoding="utf-8"?><configuration><packageSources><clear/><add key="official-godot-local" value="{local}"/><add key="nuget.org" value="https://api.nuget.org/v3/index.json"/></packageSources></configuration>\n', encoding='utf-8', newline='\n')
 return doctor()


def build():
 run([DOTNET,'restore','FireRed.Current.slnx','--locked-mode','--disable-parallel','--source',GODOT.parent/'GodotSharp/Tools/nupkgs','-p:NuGetAudit=false','-m:1','-nr:false'],'restore.log')
 run([DOTNET,'build','FireRed.Current.slnx','--no-restore','-m:1','-nr:false'],'build.log');return 0


def test():
 run([DOTNET,'run','--project','tests/Game.CurrentComposition.Tests','--no-build','--',ROOT,ROOT/'evidence/current-default'],'Game.CurrentComposition.Tests.json')
 run([DOTNET,'run','--project','tests/Game.SourceLifecycle.Tests','--no-build','--',ROOT],'Game.SourceLifecycle.Tests.json')
 run([DOTNET,'run','--project','tests/Game.SourceTrainerPolicy.Tests','--no-build','--',ROOT],'Game.SourceTrainerPolicy.Tests.log')
 for name in ['Game.Domain.Tests','Game.Integration.Tests','Game.GrowthCapture.Tests','Game.Audit.Tests','Game.Story.Tests']:
  run([DOTNET,'run','--project',f'tests/{name}','--no-build'],name+'.json')
 run([DOTNET,'run','--project','tests/fixtures/content/ContentFixtureVerifier.csproj','--no-build','--','tests/fixtures/content'],'Game.Content.Tests.json')
 return 0


def probe():
 run([DOTNET,'build','src/Game.Godot/Game.Godot.csproj','-m:1','-nr:false'],'p0-build.log')
 run([GODOT,'--headless','--editor','--path','src/Game.Godot','--import','--quit'],'p0-import.log')
 run([GODOT,'--headless','--path','src/Game.Godot','--','--probe'],'p0-editor-runtime.log',{'FIRERED_EVIDENCE':str(ROOT/'evidence/p0-editor-runtime.json')})
 return 0


def export():
 dest=ROOT/'exports/linux/firered-probe.x86_64';dest.parent.mkdir(parents=True,exist_ok=True)
 run([GODOT,'--headless','--path','src/Game.Godot','--export-release','Linux x86_64',dest],'p0-export.log')
 run([dest,'--headless','--','--probe'],'p0-export-runtime.log',{'FIRERED_EVIDENCE':str(ROOT/'evidence/p0-export-runtime.json')})
 return 0


def verify_p0():
 checks=[]
 runtimes={}
 for name in ['editor','export','window','export-window']:
  p=ROOT/f'evidence/p0-{name}-runtime.json'
  try:
   d=json.loads(p.read_text(encoding='utf-8'));runtimes[name]=d;ok=d['runtimeMajor']==10 and d['engine'].startswith('4.7.2') and d['targetFramework']=='.NETCoreApp,Version=v10.0' and d['nodeEnteredSceneTree']
   if 'window'in name:ok=ok and d['display']!='headless'
   checks.append({'id':name+'-runtime','passed':bool(ok),'runtime':d['runtime'],'display':d['display']})
  except Exception as ex:checks.append({'id':name+'-runtime','passed':False,'error':str(ex)})
 for a,b in [('editor','window'),('export','export-window')]:
  same=bool(runtimes.get(a,{}).get('moduleVersionId')) and runtimes.get(a,{}).get('moduleVersionId')==runtimes.get(b,{}).get('moduleVersionId')
  checks.append({'id':a+'-window-same-binary','passed':same})
 for name in ['window','export-window']:
  p=ROOT/f'evidence/p0-{name}-runtime.events.log';log=p.read_text(encoding='utf-8') if p.exists() else ''
  checks.extend([{'id':name+'-chinese','passed':'CHINESE_GLYPHS PASS'in log},{'id':name+'-input','passed':'INPUT_PROBE Right'in log and 'INPUT_PROBE Enter'in log},{'id':name+'-screenshot','passed':(ROOT/f'evidence/p0-{name}-runtime.png').exists()},{'id':name+'-audio','passed':'AUDIO_DEVICE_VERIFIED'in log,'detail':'Dummy/audio request does not prove audible output; needs a real output or capture check.'}])
 result={'stage':'P0','status':'passed' if all(c['passed'] for c in checks) else 'incomplete','checks':checks,'bulkContentImportAllowed':all(c['passed'] for c in checks)}
 (ROOT/'evidence/p0-gate.json').write_text(json.dumps(result,indent=2)+'\n', encoding='utf-8', newline='\n');return output(result,0 if result['status']=='passed' else 2)


def main():
 args=sys.argv[1:]
 if not args:return output({'commands':['doctor','setup','build','test','test-current-checkpoints HANDOFF_SAVE BILL_SAVE OUTPUT_DIRECTORY','test-current-battles CURRENT_CHECKPOINT OUTPUT_DIRECTORY','test-current-items CURRENT_CHECKPOINT OUTPUT_JSON','probe','export linux','verify p0','content validate FILE','scenario smoke','convert-current-checkpoint SOURCE NEW_DESTINATION'],'scope':'Current product and maintained contracts only. Historical per-stage runners are retained in Git history; see docs/runtime-retirement.md.'})
 if args==['doctor']:return doctor()
 if args==['setup']:return setup()
 if args==['build']:return build()
 if args==['test']:return test()
 if len(args)==3 and args[0]=='test-current-items':
  checkpoint=pathlib.Path(args[1]).resolve(); destination=pathlib.Path(args[2]).resolve()
  if not checkpoint.is_file():raise ValueError('A strict current checkpoint is required.')
  if destination.exists():raise ValueError('Refusing to replace prior evidence.')
  destination.parent.mkdir(parents=True,exist_ok=True)
  run([DOTNET,'run','--project','tests/Game.CurrentFieldItems.Tests','--no-build','--',ROOT,checkpoint,destination]);return 0
 if len(args)==3 and args[0]=='test-current-battles':
  checkpoint=pathlib.Path(args[1]).resolve(); destination=pathlib.Path(args[2]).resolve()
  prerequisites=[checkpoint,ROOT/'evidence/current-composition-20261013/conversion-run01/current.json',ROOT/'tests/Game.FiveIslandCampaign.Tests/evidence/recovery-20261013-run02/before-gideon.json']
  for path in prerequisites:
   if not path.is_file():raise ValueError('Missing documented current battle test input: '+str(path))
  if destination.exists():raise ValueError('Refusing to replace prior evidence.')
  destination.mkdir(parents=True)
  run([DOTNET,'run','--project','tests/Game.CanonicalWildApplication.Tests','--no-build','--',ROOT,checkpoint,destination/'wild.json'])
  run([DOTNET,'run','--project','tests/Game.CanonicalTrainerApplication.Tests','--no-build','--',ROOT,destination/'trainer.json'])
  return 0
 if len(args)==4 and args[0]=='test-current-checkpoints':
  run([DOTNET,'run','--project','tests/Game.CurrentComposition.Tests','--no-build','--',ROOT,*args[1:]],'current-checkpoint-tests.log');return 0
 if args==['probe']:return probe()
 if args==['export','linux']:return export()
 if args==['verify','p0']:return verify_p0()
 if args[0] in ['content','scenario','save','convert-current-checkpoint']:
  run([DOTNET,'run','--project','src/Game.Tooling','--no-build','--',*args],'tooling-last.log');return 0
 return output({'error':'unknown_or_retired_command','arguments':args,'help':'Run ./dev for maintained commands. Historical runners require their historical source revision.'},2)
try:sys.exit(main())
except Exception as ex:sys.exit(output({'error':str(ex)},1))
