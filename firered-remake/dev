#!/usr/bin/env python3
"""One reproducible entry point. Never install, relax a gate, or rewrite golden results implicitly."""
import sys, os, json, subprocess, pathlib, hashlib, re, shutil, tarfile, zipfile, shlex, tempfile
ROOT=pathlib.Path(__file__).resolve().parent
LOCK=json.loads((ROOT/'toolchain.lock.json').read_text(encoding='utf-8'))
for variable,filename in [('FIRERED_TOOLCHAIN_ROOT','toolchain-root'),('FIRERED_ORIGINAL_REFERENCE','reference-root')]:
 local=ROOT/'.tools'/filename
 if variable not in os.environ and local.is_file():os.environ[variable]=local.read_text(encoding='utf-8').strip()
TOOLS=pathlib.Path(os.environ.get('FIRERED_TOOLCHAIN_ROOT','/workspace/shared/firered-toolchains'))

def find_tool(variable, name, candidates):
 explicit=os.environ.get(variable)
 if explicit:
  resolved=shutil.which(explicit)
  return pathlib.Path(resolved or explicit).resolve()
 for candidate in candidates:
  if candidate.is_file():return candidate.resolve()
 return pathlib.Path(shutil.which(name) or candidates[0]).resolve()

DOTNET=find_tool('FIRERED_DOTNET','dotnet',[TOOLS/('dotnet/dotnet.exe' if os.name=='nt' else 'dotnet/dotnet')])
godot_candidates=[]
if os.name=='nt':
 godot_candidates.extend(sorted((TOOLS/'godot').glob('**/Godot_v4.7.2-stable_mono_win64_console.exe')))
else:
 godot_candidates.append(TOOLS/'godot/Godot_v4.7.2-stable_mono_linux_x86_64/Godot_v4.7.2-stable_mono_linux.x86_64')
if not godot_candidates:godot_candidates=[TOOLS/'godot/godot.exe']
GODOT=find_tool('GODOT','godot',godot_candidates)
# A PATH launcher may sit next to the real executable and GodotSharp packages.
NUPKGS=pathlib.Path(os.environ.get('FIRERED_GODOT_NUGET_SOURCE',str(GODOT.parent/'GodotSharp/Tools/nupkgs'))).resolve()
ENV=os.environ.copy()
ENV['FIRERED_TOOLCHAIN_ROOT']=str(TOOLS)
ENV.update(DOTNET_ROOT=str(DOTNET.parent),DOTNET_CLI_HOME=str(ROOT/'.toolhome'),NUGET_PACKAGES=str(ROOT/'.toolhome/nuget'),XDG_DATA_HOME=str(ROOT/'.toolhome/share'),XDG_CONFIG_HOME=str(ROOT/'.toolhome/config'),XDG_CACHE_HOME=str(ROOT/'.toolhome/cache'),DOTNET_NOLOGO='1',DOTNET_CLI_TELEMETRY_OPTOUT='1',DOTNET_MULTILEVEL_LOOKUP='0')
ENV['GODOT']=str(GODOT)
ENV['FIRERED_DOTNET']=str(DOTNET)
ENV['FIRERED_GODOT_NUGET_SOURCE']=str(NUPKGS)
ENV['PATH']=str(DOTNET.parent)+os.pathsep+ENV.get('PATH','')
for key in ('DOTNET_CLI_HOME','NUGET_PACKAGES','XDG_DATA_HOME','XDG_CONFIG_HOME','XDG_CACHE_HOME'): pathlib.Path(ENV[key]).mkdir(parents=True,exist_ok=True)
(ROOT/'evidence').mkdir(exist_ok=True)
def output(value, code=0):
 print(json.dumps(value,ensure_ascii=False,indent=2)); return code


def run(args,log=None,extra=None,cwd=ROOT):
 env=ENV| (extra or {})
 print('Running: '+subprocess.list2cmdline([str(a) for a in args]),flush=True)
 lines=[]
 with subprocess.Popen([str(a) for a in args],cwd=cwd,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True,encoding='utf-8',errors='replace') as p:
  for line in p.stdout:
   lines.append(line);print(line,end='',flush=True)
  code=p.wait()
 stdout=''.join(lines)
 if log:(ROOT/'evidence'/log).write_text(stdout, encoding='utf-8', newline='\n')
 if code or re.search(r'^ERROR:',stdout,re.M): raise RuntimeError(f'command failed ({code}): {args}')
 return stdout


def doctor():
 checks=[]
 for label,path,args,expected in [('dotnetSdk',DOTNET,['--version'],'10.0 (stable SDK >= 10.0.100)'),('godot',GODOT,['--version'],'4.7.2.stable.mono')]:
  if not path.exists():checks.append({'id':label,'passed':False,'error':'missing_tool','path':str(path)});continue
  result=subprocess.run([str(path),*args],cwd=ROOT,env=ENV,capture_output=True,text=True,encoding='utf-8',errors='replace')
  actual=result.stdout.strip()
  compatible=bool(re.fullmatch(r'10\.0\.\d+',actual)) and int(actual.rsplit('.',1)[1])>=100 if label=='dotnetSdk' else actual.startswith(expected)
  checks.append({'id':label,'passed':result.returncode==0 and compatible,'path':str(path),'actual':actual,'expected':expected,'error':result.stderr.strip() if result.returncode else None})
 checks.append({'id':'godotNugetPackages','passed':(NUPKGS/f"Godot.NET.Sdk.{LOCK['godotSdk']}.nupkg").is_file(),'path':str(NUPKGS)})
 result={'stage':'doctor','passed':all(c['passed'] for c in checks),'checks':checks,'note':'Tool availability is not P0 compatibility or audio acceptance.'}
 (ROOT/'evidence/doctor.json').write_text(json.dumps(result,indent=2)+'\n', encoding='utf-8', newline='\n');return output(result,0 if result['passed'] else 1)


def setup():
 # Explicit only. Official archives and hash values are fixed in the reviewed lock file.
 import urllib.request
 if sys.platform!='linux':
  return output({'error':'setup_platform_unsupported','help':'The pinned download bundle is Linux-only. Install .NET 10 SDK and Godot 4.7.2 .NET for your OS, add them to PATH or set FIRERED_DOTNET and GODOT, then run python dev doctor.'},2)
 target=TOOLS/'downloads';target.mkdir(parents=True,exist_ok=True)
 for a in LOCK['assets']:
  p=target/a['name'];alg='sha512' if 'sha512'in a else 'sha256'
  if not p.exists():urllib.request.urlretrieve(a['url'],p)
  with p.open('rb') as f:actual=hashlib.file_digest(f,alg).hexdigest()
  if actual!=a[alg]:raise RuntimeError('toolchain_hash_mismatch: '+a['name'])
 if not DOTNET.exists():
  DOTNET.parent.mkdir(parents=True,exist_ok=True)
  with tarfile.open(target/'dotnet-sdk-10.0.401-linux-x64.tar.gz') as t:t.extractall(DOTNET.parent,filter='data')
 if not GODOT.exists():
  with zipfile.ZipFile(target/'Godot_v4.7.2-stable_mono_linux_x86_64.zip') as z:z.extractall(TOOLS/'godot')
 GODOT.chmod(0o755)
 dest=pathlib.Path(ENV['XDG_DATA_HOME'])/'godot/export_templates/4.7.2.stable.mono';dest.mkdir(parents=True,exist_ok=True)
 with zipfile.ZipFile(target/'Godot_v4.7.2-stable_mono_export_templates.tpz') as z:
  for name in ['linux_debug.x86_64','linux_release.x86_64','version.txt']:(dest/name).write_bytes(z.read('templates/'+name))
 return doctor()


def build():
 if doctor():return 1
 run([DOTNET,'restore','FireRed.Current.slnx','--disable-parallel','--source',NUPKGS,'--source','https://api.nuget.org/v3/index.json','-p:NuGetAudit=false','-m:1','-nr:false'],'restore.log')
 run([DOTNET,'build','FireRed.Current.slnx','--no-restore','-m:1','-nr:false'],'build.log');return 0


def test(arguments=()):
 run([DOTNET,'test','FireRed.Current.slnx','-m:1','-nr:false',*arguments])
 return 0


def probe():
 run([DOTNET,'build','src/Game.Godot/Game.Godot.csproj','-m:1','-nr:false'],'p0-build.log')
 run([GODOT,'--headless','--editor','--path','src/Game.Godot','--import','--quit'],'p0-import.log')
 run([GODOT,'--headless','--path','src/Game.Godot','--','--probe'],'p0-editor-runtime.log',{'FIRERED_EVIDENCE':str(ROOT/'evidence/p0-editor-runtime.json')})
 return 0


def play(arguments):
 if len(arguments)>1:raise ValueError('Usage: python dev run [current-checkpoint.json]')
 extra={'FIRERED_PROJECT_ROOT':str(ROOT),'FIRERED_CAMPAIGN_CHECKPOINT':''}
 if arguments:
  checkpoint=pathlib.Path(arguments[0]).resolve()
  if not checkpoint.is_file():raise FileNotFoundError(checkpoint)
  extra['FIRERED_CAMPAIGN_CHECKPOINT']=str(checkpoint)
 # Ordinary play uses the OS user-data directory, never the build tool's XDG cache.
 extra.update({key:os.environ.get(key,str(pathlib.Path.home()/default)) for key,default in
               [('XDG_DATA_HOME','.local/share'),('XDG_CONFIG_HOME','.config'),('XDG_CACHE_HOME','.cache')]})
 run([GODOT,'--headless','--editor','--path','src/Game.Godot','--import','--quit'])
 run([GODOT,'--path','src/Game.Godot'],extra=extra)
 return 0


def export():
 if sys.platform!='linux':raise RuntimeError('Current packaging supports Linux x86_64 only.')
 template=pathlib.Path(ENV['XDG_DATA_HOME'])/'godot/export_templates/4.7.2.stable.mono/linux_release.x86_64'
 if not template.is_file():
  raise FileNotFoundError(f'Missing official Godot 4.7.2 .NET Linux export template: {template}. Install the matching official templates before exporting; no package was created.')
 generated=ROOT/'content/generated'
 if not generated.is_dir() or not any(generated.iterdir()):raise FileNotFoundError('Missing content/generated: restore the private resources before exporting.')
 destination=ROOT/'exports/linux'
 if destination.exists():raise FileExistsError(f'{destination} already exists. Move the previous package aside before exporting.')
 destination.parent.mkdir(parents=True,exist_ok=True)
 # Stage a complete package; a failed export must never look like a finished release.
 with tempfile.TemporaryDirectory(prefix='firered-linux-') as temporary:
  stage=pathlib.Path(temporary);executable=stage/'firered.x86_64'
  run([GODOT,'--headless','--editor','--path','src/Game.Godot','--import','--quit'],'current-export-import.log')
  run([GODOT,'--headless','--path','src/Game.Godot','--export-release','Linux x86_64',executable],'current-export.log')
  for required in ('Game.Godot.dll','libcoreclr.so','System.Private.CoreLib.dll'):
   if not any(stage.rglob(required)):raise RuntimeError(f'Export did not bundle required .NET runtime output: {required}')
  shutil.copytree(generated,stage/'content/generated')
  shutil.copy2(ROOT/'src/Game.Godot/Assets/FONT-LICENSE.txt',stage/'FONT-LICENSE.txt')
  # Verify the actual Current entry using only package files and bundled .NET.
  clean={key:value for key,value in os.environ.items() if not key.startswith(('FIRERED_','DOTNET_')) and key not in ('GODOT','NUGET_PACKAGES','LD_LIBRARY_PATH')}
  clean['PATH']=os.defpath
  with tempfile.TemporaryDirectory(prefix='firered-package-check-') as isolated:
   clean.update({key:str(pathlib.Path(isolated)/name) for key,name in [('HOME','home'),('XDG_DATA_HOME','data'),('XDG_CONFIG_HOME','config'),('XDG_CACHE_HOME','cache')]})
   checked=subprocess.run([str(executable),'--headless','--quit-after','120'],cwd=isolated,env=clean,capture_output=True,text=True,timeout=120)
  log=checked.stdout+checked.stderr
  (ROOT/'evidence/current-export-runtime.log').write_text(log,encoding='utf-8')
  if checked.returncode or re.search(r'^ERROR:',log,re.M) or 'playerEntryReady' not in log or 'audioCatalog' not in log or 'audioFault' in log or '"runtimeMajor": 10' not in log:
   raise RuntimeError('Exported Current startup failed; see evidence/current-export-runtime.log. No finished package was created.')
  shutil.move(str(stage),str(destination))
 return output({'package':str(destination),'startup':'Current headless passed','note':'Window, New Game/save/Continue and real audio require separate acceptance.'})


def verify_p0():
 checks=[]
 runtimes={}
 for name in ['editor','export','window','export-window']:
  p=ROOT/f'evidence/p0-{name}-runtime.json'
  try:
   d=json.loads(p.read_text(encoding='utf-8'));runtimes[name]=d;ok=d['runtimeMajor']==10 and d['engine'].startswith('4.7.2') and d['targetFramework']=='.NETCoreApp,Version=v10.0' and d['nodeEnteredSceneTree']
   if 'window'in name:ok=ok and d['display']!='headless'
   checks.append({'id':name+'-runtime','passed':bool(ok),'runtime':d['runtime'],'display':d['display']})
  except Exception as ex:checks.append({'id':name+'-runtime','passed':False,'error':str(ex)})
 for a,b in [('editor','window'),('export','export-window')]:
  same=bool(runtimes.get(a,{}).get('moduleVersionId')) and runtimes.get(a,{}).get('moduleVersionId')==runtimes.get(b,{}).get('moduleVersionId')
  checks.append({'id':a+'-window-same-binary','passed':same})
 for name in ['window','export-window']:
  p=ROOT/f'evidence/p0-{name}-runtime.events.log';log=p.read_text(encoding='utf-8') if p.exists() else ''
  checks.extend([{'id':name+'-chinese','passed':'CHINESE_GLYPHS PASS'in log},{'id':name+'-input','passed':'INPUT_PROBE Right'in log and 'INPUT_PROBE Enter'in log},{'id':name+'-screenshot','passed':(ROOT/f'evidence/p0-{name}-runtime.png').exists()},{'id':name+'-audio','passed':'AUDIO_DEVICE_VERIFIED'in log,'detail':'Dummy/audio request does not prove audible output; needs a real output or capture check.'}])
 result={'stage':'P0','status':'passed' if all(c['passed'] for c in checks) else 'incomplete','checks':checks,'bulkContentImportAllowed':all(c['passed'] for c in checks)}
 (ROOT/'evidence/p0-gate.json').write_text(json.dumps(result,indent=2)+'\n', encoding='utf-8', newline='\n');return output(result,0 if result['status']=='passed' else 2)


def main():
 args=sys.argv[1:]
 if not args or args in (['-h'],['--help']):return output({'commands':['doctor','env [--json]','setup','build','test','probe','run [current-checkpoint.json]','export linux','verify p0','content validate FILE','scenario smoke','convert-current-checkpoint SOURCE NEW_DESTINATION'],'scope':'Current product and maintained contracts only. Historical per-stage runners are retained in Git history; see docs/runtime-retirement.md.'})
 if args==['doctor']:return doctor()
 if args in (['env'],['env','--json']):
  exported={key:ENV[key] for key in ('FIRERED_TOOLCHAIN_ROOT','FIRERED_DOTNET','FIRERED_GODOT_NUGET_SOURCE','DOTNET_ROOT','GODOT','DOTNET_CLI_HOME','NUGET_PACKAGES','XDG_DATA_HOME','XDG_CONFIG_HOME','XDG_CACHE_HOME','DOTNET_NOLOGO','DOTNET_CLI_TELEMETRY_OPTOUT','DOTNET_MULTILEVEL_LOOKUP')}
  if args==['env','--json']:return output(exported|{'PATH':ENV['PATH']})
  for key,value in exported.items():
   print(f'export {key}={shlex.quote(value)}')
  return 0
 if args==['setup']:return setup()
 if args==['build']:return build()
 if args and args[0]=='test':return test(args[1:])
 if args==['probe']:return probe()
 if args and args[0]=='run':return play(args[1:])
 if args==['export','linux']:return export()
 if args==['verify','p0']:return verify_p0()
 if args[0] in ['content','scenario','save','convert-current-checkpoint']:
  run([DOTNET,'run','--project','src/Game.Tooling','--no-build','--',*args],'tooling-last.log');return 0
 return output({'error':'unknown_or_retired_command','arguments':args,'help':'Run ./dev for maintained commands. Historical runners require their historical source revision.'},2)
try:sys.exit(main())
except Exception as ex:sys.exit(output({'error':str(ex)},1))
