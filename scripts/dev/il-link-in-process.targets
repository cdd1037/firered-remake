<Project>
  <!-- Explicit opt-in only through CustomAfterMicrosoftCommonTargets.
       Same official ILLink tasks, without the task-host Unix-socket IPC that
       this cloud sandbox rejects. SDK files and linker arguments are unchanged. -->
  <UsingTask TaskName="ILLink" AssemblyFile="$(ILLinkTasksAssembly)"
             TaskFactory="AssemblyTaskFactory" Override="true"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
  <UsingTask TaskName="ComputeManagedAssemblies" AssemblyFile="$(ILLinkTasksAssembly)"
             TaskFactory="AssemblyTaskFactory" Override="true"
             Condition="'$(MSBuildRuntimeType)' == 'Core'" />
</Project>
