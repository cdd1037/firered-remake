#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <assert.h>
typedef uint8_t u8;typedef int8_t s8;typedef uint16_t u16;typedef int16_t s16;typedef uint32_t u32;typedef int32_t s32;typedef u8 bool8;
#define TRUE 1
#define FALSE 0
#define MAX_SPRITES 64
#define NUM_TASKS 16
#define REVISION 0
#define DISPLAY_WIDTH 240
#define DISPLAY_HEIGHT 160
#define SAFE_DIV(a,b) ((b)?(a)/(b):0)
#define FREE_SPRITE_TILE(i) abort()
#define sAnchorX data[6]
#define sAnchorY data[7]
@TYPES@
@DEFINES@
_Static_assert(sizeof(union AffineAnimCmd)==8,"ARM source command stride must be8");
struct Sprite;typedef void (*SpriteCallback)(struct Sprite *);typedef void (*AnimFunc)(struct Sprite *);typedef void (*AnimCmdFunc)(struct Sprite *);typedef void (*AffineAnimCmdFunc)(u8,struct Sprite *);typedef void (*TaskFunc)(u8);
struct SpriteFrameImage {const void *data;u16 size;};
struct SpriteTemplate {u16 tileTag,paletteTag;const struct OamData *oam;const union AnimCmd *const *anims;const struct SpriteFrameImage *images;const union AffineAnimCmd *const *affineAnims;SpriteCallback callback;};
struct Sprite {const struct SpriteTemplate *template;bool8 invisible;struct OamData oam;const union AnimCmd *const *anims;const union AffineAnimCmd *const *affineAnims;const struct SpriteFrameImage *images;s16 x,y,x2,y2,data[8];s8 centerToCornerVecX,centerToCornerVecY;SpriteCallback callback;bool8 inUse,animBeginning,affineAnimBeginning,usingSheet,animEnded,affineAnimEnded,animPaused,affineAnimPaused,anchored,hFlip,vFlip;u8 animCmdIndex,animNum,animLoopCounter,animDelayCounter,subpriority;u16 sheetTileStart;};
struct Task {TaskFunc func;bool8 isActive;u8 prev,next,priority;s16 data[16];};
struct OamMatrix {s16 a,b,c,d;};struct ObjAffineSrcData {s16 xScale,yScale;u16 rotation;};
struct Sprite gSprites[64],destroyedSprites[64];struct Task gTasks[16];struct AffineAnimState sAffineAnimStates[32];struct OamMatrix gOamMatrices[32];
s16 gBattleAnimArgs[8];u8 gAnimVisualTaskCount;bool8 gAffineAnimsDisabled=FALSE;
static int frame,kind,doubles,geometry,visibleMask,instanceCounter,instance[64],tracked[64],wasDestroyed[64],attempt;
static long long events[512][8];static int nEvents;
static void event(int k,long long a,long long b,long long c,long long d,long long e,long long f,long long g){assert(nEvents<512);long long*p=events[nEvents++];p[0]=k;p[1]=a;p[2]=b;p[3]=c;p[4]=d;p[5]=e;p[6]=f;p[7]=g;}
static void ObjAffineSet(const struct ObjAffineSrcData*src,struct OamMatrix*dest,int count,int offset){assert(count==1&&offset==2);memset(dest,0,sizeof(*dest));if(src->rotation==0){dest->a=src->xScale;dest->d=src->yScale;}}
static void UpdateSpriteMatrixAnchorPos(struct Sprite*s,s32 x,s32 y){abort();}
static void RequestSpriteFrameImageCopy(u16 image,u16 tile,const void*images){abort();}
static void FreeOamMatrix(u8 matrix){event(6,matrix,0,0,0,0,0,0);}
static void DestroySprite(struct Sprite*s);
static void StoreSpriteCallbackInData6(struct Sprite*s,SpriteCallback cb);
static void SetCallbackToStoredInData6(struct Sprite*s);
u8 gBattleAnimAttacker,gBattleAnimTarget,gBattlerPositions[4]={0,1,2,3},gBattlerSpriteIds[4]={0,1,2,3};u32 gBattleTypeFlags;
static bool8 IsContest(void){return FALSE;}static bool8 IsDoubleBattle(void){return doubles;}static bool8 IsBattlerSpriteVisible(u8 id){return (visibleMask>>id)&1;}static bool8 IsBattlerSpritePresent(u8 id){return TRUE;}
u8 GetBattlerSpriteSubpriority(u8 id);u8 GetBattlerSpriteCoord(u8 id,u8 coord);u8 GetBattlerSpriteCoord2(u8 id,u8 coord);
struct UCoords8 {u8 x,y;};
struct HealthBoxData {bool8 statusAnimActive;u8 matrixNum;};struct BattleSpritesData {struct HealthBoxData healthBoxesData[4];};static struct BattleSpritesData battleSprites;static struct BattleSpritesData*gBattleSpritesDataPtr=&battleSprites;
struct MonCoords {u8 size,y_offset;};static struct MonCoords explicitCoords[4];
#define GET_MON_COORDS_WIDTH(size) (((size)>>4)*8)
#define GET_MON_COORDS_HEIGHT(size) (((size)&15)*8)
static u8 GetBattlerYDelta(u8 id,u16 species){return explicitCoords[id].y_offset;}
static u8 GetBattlerElevation(u8 id,u16 species){return 0;}
static u16 GetBattlerYDeltaFromSpriteId(u8 id){for(int i=0;i<4;i++)if(gBattlerSpriteIds[i]==id)return explicitCoords[i].y_offset;return MON_PIC_HEIGHT;}
static const u8*sBattleAnimScriptPtr;
static uintptr_t ReadTemplatePointer(const u8*ptr);
#define T2_READ_32(ptr) ReadTemplatePointer(ptr)
#define T1_READ_16(ptr) ((u16)((ptr)[0]|((u16)(ptr)[1]<<8)))
@PROTOTYPES@
static u8 CreateSprite(const struct SpriteTemplate*,s16,s16,u8);static u8 CreateSpriteAt(u8,const struct SpriteTemplate*,s16,s16,u8);
@ARRAYS@
@FUNCTIONS@
static uintptr_t ReadTemplatePointer(const u8*ptr){const struct SpriteTemplate*ts[]={&gThoughtBubbleSpriteTemplate,&gMetronomeFingerSpriteTemplate,&gLetterZSpriteTemplate};assert(ptr[0]<3&&ptr[1]==0&&ptr[2]==0&&ptr[3]==0);return (uintptr_t)ts[ptr[0]];}
static void ScriptCreate(int k){int offsets[]={11,12,2},counts[]={2,1,4};u8 code[32]={0};code[1]=k;code[5]=offsets[k]+(k==2?ANIMSPRITE_IS_TARGET:0);code[6]=counts[k];for(int i=0;i<counts[k];i++){code[7+2*i]=(u16)gBattleAnimArgs[i]&255;code[8+2*i]=(u16)gBattleAnimArgs[i]>>8;}sBattleAnimScriptPtr=code;Cmd_createsprite();}
static int templateId(const struct SpriteTemplate*t){if(t==&gThoughtBubbleSpriteTemplate)return 0;if(t==&gMetronomeFingerSpriteTemplate)return 1;if(t==&gLetterZSpriteTemplate)return 2;return -1;}
static int callbackId(SpriteCallback cb){if(cb==DestroyAnimSprite)return 1;if(cb==AnimThoughtBubble_Step)return 2;if(cb==AnimMetronomeFinger_Step)return 3;if(cb==DestroySpriteAndMatrix)return 4;abort();}
static SpriteCallback callbackFromId(int id){switch(id){case 1:return DestroyAnimSprite;case 2:return AnimThoughtBubble_Step;case 3:return AnimMetronomeFinger_Step;case 4:return DestroySpriteAndMatrix;default:abort();}}
static void StoreSpriteCallbackInData6(struct Sprite*s,SpriteCallback cb){s->data[6]=callbackId(cb);s->data[7]=0;event(15,s-gSprites,s->data[6],0,0,0,0,0);}
static void SetCallbackToStoredInData6(struct Sprite*s){assert(s->data[7]==0);s->callback=callbackFromId(s->data[6]);}
static u8 CreateSpriteAt(u8 slot,const struct SpriteTemplate*t,s16 x,s16 y,u8 priority){struct Sprite*s=&gSprites[slot];ResetSprite(s);s->template=t;s->inUse=TRUE;s->animBeginning=s->affineAnimBeginning=TRUE;s->usingSheet=TRUE;s->subpriority=priority;s->oam=*t->oam;s->anims=t->anims;s->affineAnims=t->affineAnims;s->callback=t->callback;s->x=x;s->y=y;CalcCenterToCornerVec(s,s->oam.shape,s->oam.size,s->oam.affineMode);if(s->oam.affineMode&1){s->oam.matrixNum=slot%32;AffineAnimStateReset(slot%32);}instance[slot]=++instanceCounter;wasDestroyed[slot]=0;tracked[slot]=1;return slot;}
static u8 CreateSprite(const struct SpriteTemplate*t,s16 x,s16 y,u8 priority){u8 slot=SourceCreateSprite(t,x,y,priority);event(3,slot,templateId(t),x,y,priority,++attempt,0);return slot;}
static void DestroySprite(struct Sprite*s){int slot=s-gSprites;event(4,slot,instance[slot],s->data[0],s->animEnded,templateId(s->template),0,0);if(s->inUse){destroyedSprites[slot]=*s;wasDestroyed[slot]=1;SourceDestroySprite(s);}}
static const char*callbackName(SpriteCallback cb){
#define CB(name) if(cb==name)return #name
CB(AnimThoughtBubble);CB(AnimThoughtBubble_Step);CB(AnimMetronomeFinger);CB(AnimMetronomeFinger_Step);CB(AnimLetterZ);CB(RunStoredCallbackWhenAnimEnds);CB(RunStoredCallbackWhenAffineAnimEnds);CB(DestroyAnimSprite);CB(DestroySpriteAndMatrix);CB(SpriteCallbackDummy);
#undef CB
return "unknown";}
static void numbers(const s16*a,int n){for(int i=0;i<n;i++)printf("%s%d",i?",":"",a[i]);}
static void inputsOut(void){if(frame!=0)return;printf(",\"inputs\":{\"widths\":[");for(int i=0;i<4;i++)printf("%s%d",i?",":"",GET_MON_COORDS_WIDTH(explicitCoords[i].size));printf("],\"heights\":[");for(int i=0;i<4;i++)printf("%s%d",i?",":"",GET_MON_COORDS_HEIGHT(explicitCoords[i].size));printf("],\"yOffsets\":[");for(int i=0;i<4;i++)printf("%s%d",i?",":"",explicitCoords[i].y_offset);printf("],\"elevations\":[0,0,0,0],\"subpriorities\":[");for(int i=0;i<4;i++)printf("%s%d",i?",":"",GetBattlerSpriteSubpriority(i));printf("],\"coordinates\":[");for(int i=0;i<4;i++)printf("%s[%d,%d,%d,%d]",i?",":"",GetBattlerSpriteCoord(i,0),GetBattlerSpriteCoord(i,1),GetBattlerSpriteCoord(i,2),GetBattlerSpriteCoord(i,3));printf("]}");}
static void eventsOut(void){inputsOut();printf(",\"events\":[");for(int i=0;i<nEvents;i++){printf("%s[",i?",":"");for(int j=0;j<8;j++)printf("%s%lld",j?",":"",events[i][j]);printf("]");}puts("]}");nEvents=0;}
static void spriteOut(int slot){struct Sprite*s=&gSprites[slot];bool8 dead=!s->inUse;if(dead&&wasDestroyed[slot])s=&destroyedSprites[slot];struct AffineAnimState*a=&sAffineAnimStates[s->oam.matrixNum];printf("{\"slot\":%d,\"alive\":%d,\"instance\":%d,\"destroyedSnapshot\":%d,\"templateId\":%d,\"callback\":\"%s\",\"position\":[%d,%d,%d,%d],\"tile\":%u,\"visible\":%d,\"priority\":%u,\"subpriority\":%u,\"affineMode\":%u,\"objMode\":%u,\"xScale\":%d,\"yScale\":%d,\"rotation\":%u,\"affineAnimNum\":%u,\"affineCmdIndex\":%u,\"affineDelay\":%u,\"affineLoop\":%u,\"animNum\":%u,\"animCmdIndex\":%u,\"animDelay\":%u,\"animBeginning\":%u,\"affineBeginning\":%u,\"animEnded\":%u,\"affineEnded\":%u,\"hFlip\":%u,\"vFlip\":%u,\"oamMatrixNum\":%u,\"centerToCorner\":[%d,%d],\"data\":[",slot,!dead,instance[slot],dead&&wasDestroyed[slot],templateId(s->template),callbackName(s->callback),s->x,s->y,s->x2,s->y2,s->oam.tileNum,!s->invisible,s->oam.priority,s->subpriority,s->oam.affineMode,s->oam.objMode,a->xScale,a->yScale,a->rotation,a->animNum,a->animCmdIndex,a->delayCounter,a->loopCounter,s->animNum,s->animCmdIndex,s->animDelayCounter,s->animBeginning,s->affineAnimBeginning,s->animEnded,s->affineAnimEnded,s->hFlip,s->vFlip,s->oam.matrixNum,s->centerToCornerVecX,s->centerToCornerVecY);numbers(s->data,8);printf("]}");}
static void row(void){printf("{\"frame\":%d,\"alive\":%u,\"visualCount\":%u,\"args\":[",frame,gAnimVisualTaskCount!=0,gAnimVisualTaskCount);numbers(gBattleAnimArgs,8);printf("],\"sprite\":");spriteOut(4);eventsOut();}
static void setup(void){visibleMask=doubles?15:3;gBattleTypeFlags=doubles?BATTLE_TYPE_DOUBLE:0;int widths[2][4]={{64,40,48,56},{32,64,24,48}},heights[2][4]={{64,48,56,40},{48,64,48,64}},offsets[2][4]={{0,8,4,12},{8,0,16,0}};for(int i=0;i<64;i++)ResetSprite(&gSprites[i]);for(int i=0;i<4;i++){explicitCoords[i].size=((widths[geometry][i]/8)<<4)|(heights[geometry][i]/8);explicitCoords[i].y_offset=offsets[geometry][i];struct Sprite*s=&gSprites[i];s->inUse=TRUE;s->usingSheet=TRUE;s->callback=SpriteCallbackDummy;s->animBeginning=TRUE;s->affineAnimBeginning=TRUE;s->subpriority=GetBattlerSpriteSubpriority(i);s->oam.affineMode=1;s->oam.size=3;s->oam.matrixNum=i;s->data[0]=i;s->x=GetBattlerSpriteCoord(i,BATTLER_COORD_X_2);s->y=GetBattlerSpriteCoord(i,BATTLER_COORD_Y_PIC_OFFSET);battleSprites.healthBoxesData[i].matrixNum=i;AffineAnimStateReset(i);CalcCenterToCornerVec(s,0,3,1);gOamMatrices[i].a=gOamMatrices[i].d=256;}
}
int main(int argc,char**argv){assert(argc==14);kind=atoi(argv[1]);doubles=atoi(argv[2]);gBattleAnimAttacker=atoi(argv[3]);gBattleAnimTarget=atoi(argv[4]);geometry=atoi(argv[5]);for(int i=0;i<8;i++)gBattleAnimArgs[i]=atoi(argv[6+i]);setup();gAnimVisualTaskCount=0;ScriptCreate(kind);row();for(frame=1;frame<1000;frame++){AnimateSprites();row();if(!gAnimVisualTaskCount)break;}assert(frame<1000);assert(!gSprites[4].inUse);return 0;}
